# Never commit real values. Configure these in Railway service variables.
TRADING_MODE=paper
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_ID=123456789
INITIAL_PAPER_BALANCE=1000

# Binance credentials are intentionally not consumed by this release.
# Public market data requires no API key. Do not add live trading credentials.
